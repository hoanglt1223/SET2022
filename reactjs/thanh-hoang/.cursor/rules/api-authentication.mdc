## Error Handling Patterns

### Global Error Handler
```typescript
export const errorHandler = (error: IServerError): void => {
  switch (error?.statusCode) {
    case 401:
      redirectLogin()
      break
    // Add more status codes as needed
  }
}

function redirectLogin(): void {
  localStorage.setItem(AuthenticateParams.ACCESS_TOKEN, '')
  if (window) {
    // TODO: enable it when integrate login feature
    // window.location.href = routes.login.value
  }
}
```

## API Call Patterns

### Basic API Calls
```typescript
// GET request
const fetchUser = async (id: string): Promise<User> => {
  const response = await api.get(`/users/${id}`, {
    headers: auth()
  })
  return response.data
}

// POST request with authentication
const createUser = async (userData: ICreateUserReq): Promise<ICreateUserRes> => {
  try {
    const response = await api.post('/users', userData, {
      headers: auth()
    })
    return response.data
  } catch (error) {
    errorHandler(error.response?.data)
    throw error
  }
}
```

### Authentication API Calls
```typescript
const loginUser = async (credentials: ILoginDataReq): Promise<ILoginDataRes> => {
  const response = await api.post('/auth/login', credentials)

  // Store token on successful login
  if (response.data.token) {
    localStorage.setItem(AuthenticateParams.ACCESS_TOKEN, response.data.token)
  }

  return response.data
}

const logoutUser = (): void => {
  localStorage.removeItem(AuthenticateParams.ACCESS_TOKEN)
  // Redirect to login page
  window.location.href = routes.login.value
}
```

## Request Interceptors Pattern

### Add Request Interceptor
```typescript
api.interceptors.request.use(
  (config) => {
    // Add auth headers to all requests
    const authHeaders = auth()
    config.headers = { ...config.headers, ...authHeaders }
    return config
  },
  (error) => Promise.reject(error)
)
```

### Response Interceptor
```typescript
api.interceptors.response.use(
  (response) => response,
  (error) => {
    // Handle global errors
    errorHandler(error.response?.data)
    return Promise.reject(error)
  }
)
```

## Token Management

### Token Storage
- Use `localStorage` for token persistence
- Clear token on logout or authentication errors
- Use `AuthenticateParams.ACCESS_TOKEN` constant for consistent key naming

### Token Validation
```typescript
const isTokenValid = (): boolean => {
  const token = localStorage.getItem(AuthenticateParams.ACCESS_TOKEN)

  if (!token) return false

  try {
    // Decode and validate JWT token
    const decoded = jwt.decode(token)
    return decoded && decoded.exp > Date.now() / 1000
  } catch {
    return false
  }
}
```

## API Response Patterns

### Consistent Response Structure
```typescript
interface ApiResponse<T> {
  data: T
  message?: string
  status: number
  timestamp: string
}

interface ApiError {
  error: IServerError
  message: string
  status: number
  timestamp: string
}
```

### Error Response Handling
```typescript
const handleApiError = (error: AxiosError): never => {
  const serverError = error.response?.data as IServerError

  switch (serverError?.statusCode) {
    case 400:
      throw new Error('Bad Request: ' + serverError.message)
    case 401:
      redirectLogin()
      throw new Error('Unauthorized')
    case 403:
      throw new Error('Forbidden: ' + serverError.message)
    case 404:
      throw new Error('Not Found: ' + serverError.message)
    case 500:
      throw new Error('Server Error: ' + serverError.message)
    default:
      throw new Error('Unknown Error: ' + serverError?.message)
  }
}
```

