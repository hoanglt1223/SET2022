{
  "name": "udt-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "eslint": "eslint \"*/**/*.{js,ts,tsx}\"",
    "eslint:fix": "eslint --fix \"*/**/*.{js,ts,tsx}\"",
    "eslint:ci": "eslint \"*/**/*.{js,ts,tsx}\" --quiet",
    "prettier:fix": "prettier --write .",
    "prettier:ci": "prettier --check .",
    "lint:fix": "pnpm eslint:fix && pnpm prettier:fix",
    "preversion": "pnpm config set version-tag-prefix \"release-v\"",
    "postversion": "git push --tags && git push && echo \"Successfully released version $npm_package_version!\""
  },
  "dependencies": {
    "axios": "^1.6.2",
    "mobx": "^6.12.0",
    "mobx-react": "^9.1.0",
    "postcss-normalize": "^10.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.20.1",

    "typescript": "^5.3.2",
    "web-vitals": "^3.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.8",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-unused-imports": "^3.0.0",
    "prettier": "^3.1.0",
    "vite": "^5.1.0",
    "vitest": "^1.2.0"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
